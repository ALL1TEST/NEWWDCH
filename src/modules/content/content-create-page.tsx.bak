'use client';

import React, { useCallback, useState, useMemo } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useForm, Controller } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod/v4';
import {
  ArrowLeft, ChevronDown, Sparkles, Image as ImageIcon,
  Calendar, Clock, Search, X, Upload, FileText, Loader2, Type, Hash,
} from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Label } from '@/components/ui/label';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import {
  Select, SelectContent, SelectItem, SelectTrigger, SelectValue,
} from '@/components/ui/select';
import { Collapsible, CollapsibleTrigger, CollapsibleContent } from '@/components/ui/collapsible';
import { Separator } from '@/components/ui/separator';
import { getApi, postApi } from '@/lib/api-client';
import { queryKeys } from '@/lib/query-keys';
import { useNavigationStore } from '@/lib/stores/navigation-store';
import { slugify, cn } from '@/lib/utils';
import { toast } from 'sonner';

// -------------------- Types ----------------

interface ContentTypeOption { id: string; name: string; }
interface CategoryOption { id: string; name: string; }
interface TagOption { id: string; name: string; }
interface CreatedContent { id: string; title: string; }

// -------------------- Form Schema ----------------

const contentFormSchema = z.object({
  title: z.string().min(1, 'Title is required').max(200, 'Title must be 200 characters or less'),
  excerpt: z.string().max(300, 'Excerpt must be 300 characters or less').optional().or(z.literal('')),
  content: z.string().optional().or(z.literal('')),
  status: z.enum(['DRAFT', 'IN_REVIEW', 'APPROVED', 'PUBLISHED', 'UNPUBLISHED', 'ARCHIVED']),
  contentTypeId: z.string().min(1, 'Content type is required'),
  categoryId: z.string().optional().or(z.literal('')),
  tagIds: z.array(z.string()),
  seoTitle: z.string().max(60, 'Meta title must be 60 characters or less').optional().or(z.literal('')),
  seoDescription: z.string().max(160, 'Meta description must be 160 characters or less').optional().or(z.literal('')),
});

type ContentFormValues = z.infer<typeof contentFormSchema>;

const AI_QUICK_ACTIONS = ['Make shorter', 'Fix grammar', 'Professional tone', 'Add conclusion', 'Generate FAQ', 'Generate outline'];

// -------------------- Component ----------------

export function ContentCreatePage() {
  const navigate = useNavigationStore((s) => s.navigate);
  const queryClient = useQueryClient();
  const [tagSearch, setTagSearch] = useState('');
  const [slugValue, setSlugValue] = useState('');
  const [aiInput, setAiInput] = useState('');

  // Fetch dropdown data
  const { data: contentTypes } = useQuery({
    queryKey: queryKeys.contentTypes.all,
    queryFn: () => getApi<ContentTypeOption[]>('/api/content-types?pageSize=100'),
    staleTime: 60_000,
  });
  const { data: categories } = useQuery({
    queryKey: queryKeys.categories.all,
    queryFn: () => getApi<CategoryOption[]>('/api/categories?pageSize=200'),
    staleTime: 60_000,
  });
  const { data: allTags } = useQuery({
    queryKey: queryKeys.tags.all,
    queryFn: () => getApi<TagOption[]>('/api/tags?pageSize=200'),
    staleTime: 60_000,
  });

  const filteredTags = useMemo(() => {
    if (!allTags) return [];
    if (!tagSearch) return allTags;
    return allTags.filter((t) => t.name.toLowerCase().includes(tagSearch.toLowerCase()));
  }, [allTags, tagSearch]);

  const {
    register, handleSubmit, control, watch, setValue, formState: { errors },
  } = useForm<ContentFormValues>({
    resolver: zodResolver(contentFormSchema),
    defaultValues: { title: '', excerpt: '', content: '', status: 'DRAFT', contentTypeId: '', categoryId: '', tagIds: [], seoTitle: '', seoDescription: '' },
  });

  const selectedTagIds = watch('tagIds');
  const watchedTitle = watch('title');
  const watchedExcerpt = watch('excerpt');
  const watchedContent = watch('content');
  const watchedSeoTitle = watch('seoTitle');
  const watchedSeoDescription = watch('seoDescription');

  // Auto-slug
  React.useEffect(() => {
    setSlugValue(slugify(watchedTitle));
  }, [watchedTitle]);

  // Word count & reading time
  const wordCount = useMemo(() => {
    const text = watchedContent || '';
    return text.trim() ? text.trim().split(/\s+/).length : 0;
  }, [watchedContent]);

  const readingTime = useMemo(() => {
    const mins = Math.ceil(wordCount / 200);
    return mins < 1 ? '< 1 min read' : `${mins} min read`;
  }, [wordCount]);

  // SEO Score
  const seoScore = useMemo(() => {
    let score = 0;
    if (watchedTitle.length > 0) score += 20;
    if (watchedTitle.length <= 60) score += 10;
    if (watchedSeoTitle.length > 0) score += 20;
    if (watchedSeoTitle.length <= 60) score += 10;
    if (watchedSeoDescription.length > 0) score += 20;
    if (watchedSeoDescription.length <= 160) score += 10;
    if (watchedContent.length > 0) score += 10;
    return score;
  }, [watchedTitle, watchedSeoTitle, watchedSeoDescription, watchedContent]);

  const seoScoreColor = seoScore >= 80 ? 'text-emerald-600' : seoScore >= 50 ? 'text-amber-600' : 'text-red-600';
  const seoProgressColor = seoScore >= 80 ? '[&>div]:bg-emerald-500' : seoScore >= 50 ? '[&>div]:bg-amber-500' : '[&>div]:bg-red-500';

  // Create mutation
  const createMutation = useMutation({
    mutationFn: (data: ContentFormValues) => {
      const slug = slugify(data.title);
      return postApi<CreatedContent>('/api/content', {
        title: data.title, slug, excerpt: data.excerpt || undefined, content: data.content || undefined,
        status: data.status, contentTypeId: data.contentTypeId, categoryId: data.categoryId || undefined,
        tagIds: data.tagIds, seoTitle: data.seoTitle || undefined, seoDescription: data.seoDescription || undefined,
      });
    },
    onSuccess: (created) => {
      queryClient.invalidateQueries({ queryKey: queryKeys.content.all });
      toast.success('Content created successfully');
      navigate('content', created.id);
    },
    onError: (err: Error) => toast.error(err.message || 'Failed to create content'),
  });

  const onSubmit = useCallback((data: ContentFormValues) => createMutation.mutate(data), [createMutation]);
  const goBack = useCallback(() => navigate('content'), [navigate]);

  const addTag = useCallback((tagId: string) => {
    if (!selectedTagIds.includes(tagId)) {
      setValue('tagIds', [...selectedTagIds, tagId], { shouldValidate: true });
    }
    setTagSearch('');
  }, [selectedTagIds, setValue]);

  const removeTag = useCallback((tagId: string) => {
    setValue('tagIds', selectedTagIds.filter((id) => id !== tagId), { shouldValidate: true });
  }, [selectedTagIds, setValue]);

  const submitWithStatus = useCallback((status: string) => {
    handleSubmit((data) => createMutation.mutate({ ...data, status: status as ContentFormValues['status'] }))();
  }, [handleSubmit, createMutation]);

  const isSubmitting = createMutation.isPending;

  return (
    <div className="flex flex-col h-[calc(100vh-8rem)]">
      {/* Top Bar */}
      <div className="flex items-center justify-between border-b px-6 py-3 shrink-0">
        <div className="flex items-center gap-3">
          <Button variant="ghost" size="icon" className="h-8 w-8" onClick={goBack}>
            <ArrowLeft className="h-4 w-4" />
          </Button>
          <h1 className="text-lg font-semibold">New Article</h1>
        </div>
        <div className="flex items-center gap-2">
          <Button variant="outline" size="sm" onClick={() => submitWithStatus('DRAFT')} disabled={isSubmitting}>
            {isSubmitting && <Loader2 className="h-4 w-4 mr-2 animate-spin" />}
            {!isSubmitting && <FileText className="h-4 w-4 mr-2" />}
            Save Draft
          </Button>
          <Button variant="outline" size="sm" onClick={() => submitWithStatus('IN_REVIEW')} disabled={isSubmitting}>
            <Calendar className="h-4 w-4 mr-2" /> Schedule
          </Button>
          <Button size="sm" onClick={() => submitWithStatus('PUBLISHED')} disabled={isSubmitting}>
            {isSubmitting && <Loader2 className="h-4 w-4 mr-2 animate-spin" />}
            Publish
          </Button>
        </div>
      </div>

      {/* Main Area */}
      <div className="flex flex-1 min-h-0 overflow-hidden">
        {/* LEFT: Editor */}
        <div className="flex-1 overflow-y-auto p-6 space-y-4">
          <input
            {...register('title')}
            placeholder="Untitled Article"
            className="w-full border-0 border-b-2 border-transparent bg-transparent text-2xl font-bold placeholder:text-muted-foreground/50 focus:outline-none focus:border-primary/30 pb-2 transition-colors"
          />
          {errors.title && <p className="text-xs text-destructive -mt-2">{errors.title.message}</p>}

          <Textarea
            {...register('excerpt')}
            placeholder="Write a brief excerpt..."
            rows={2}
            className="border-0 border-b bg-transparent resize-none text-muted-foreground placeholder:text-muted-foreground/40 focus-visible:ring-0"
          />

          <Textarea
            {...register('content')}
            placeholder={"Write your content here...\n\nUse the AI assistant below to help generate, edit, or improve your content."}
            rows={20}
            className="min-h-[400px] font-mono text-sm leading-relaxed"
          />

          <div className="flex items-center gap-4 text-xs text-muted-foreground pt-2 border-t">
            <span>{wordCount} words</span>
            <span>{readingTime}</span>
            <span>{(watchedContent || '').length} characters</span>
          </div>
        </div>

        {/* RIGHT: Sidebar */}
        <aside className="w-80 border-l overflow-y-auto bg-muted/20 shrink-0">
          <div className="p-4 space-y-0.5">
            {/* 1. Featured Image */}
            <Collapsible defaultOpen>
              <CollapsibleTrigger className="flex items-center justify-between w-full py-2.5 px-1 hover:bg-muted/50 rounded-md transition-colors group">
                <span className="text-sm font-semibold">Featured Image</span>
                <ChevronDown className="h-4 w-4 text-muted-foreground transition-transform group-data-[state=open]:rotate-180" />
              </CollapsibleTrigger>
              <CollapsibleContent>
                <div className="pb-4 pt-1 px-1 space-y-3">
                  <div className="border-2 border-dashed rounded-lg p-6 flex flex-col items-center justify-center gap-2 text-center cursor-pointer hover:border-primary/50 hover:bg-muted/30 transition-colors">
                    <ImageIcon className="h-8 w-8 text-muted-foreground/50" aria-hidden="true" />
                    <p className="text-sm text-muted-foreground">Click to upload or drag and drop</p>
                    <p className="text-xs text-muted-foreground/70">PNG, JPG, WebP up to 5MB</p>
                  </div>
                  <div className="flex gap-2">
                    <Button variant="outline" size="sm" className="flex-1">
                      <Upload className="h-3.5 w-3.5 mr-1.5" /> Media Library
                    </Button>
                    <Button variant="outline" size="sm" className="flex-1">
                      <Sparkles className="h-3.5 w-3.5 mr-1.5" /> Generate with AI
                    </Button>
                  </div>
                </div>
              </CollapsibleContent>
            </Collapsible>

            <Separator className="my-1" />

            {/* 2. Publishing */}
            <Collapsible defaultOpen>
              <CollapsibleTrigger className="flex items-center justify-between w-full py-2.5 px-1 hover:bg-muted/50 rounded-md transition-colors group">
                <span className="text-sm font-semibold">Publishing</span>
                <ChevronDown className="h-4 w-4 text-muted-foreground transition-transform group-data-[state=open]:rotate-180" />
              </CollapsibleTrigger>
              <CollapsibleContent>
                <div className="pb-4 pt-1 px-1 space-y-3">
                  <div className="space-y-1.5">
                    <Label className="text-xs">Status</Label>
                    <Controller control={control} name="status" render={({ field }) => (
                      <Select value={field.value} onValueChange={field.onChange}>
                        <SelectTrigger className="h-9"><SelectValue /></SelectTrigger>
                        <SelectContent>
                          <SelectItem value="DRAFT">Draft</SelectItem>
                          <SelectItem value="IN_REVIEW">In Review</SelectItem>
                          <SelectItem value="APPROVED">Approved</SelectItem>
                          <SelectItem value="PUBLISHED">Published</SelectItem>
                          <SelectItem value="UNPUBLISHED">Unpublished</SelectItem>
                          <SelectItem value="ARCHIVED">Archived</SelectItem>
                        </SelectContent>
                      </Select>
                    )} />
                  </div>
                  <div className="space-y-1.5">
                    <Label className="text-xs">Content Type <span className="text-destructive">*</span></Label>
                    <Controller control={control} name="contentTypeId" render={({ field }) => (
                      <Select value={field.value} onValueChange={field.onChange}>
                        <SelectTrigger className="h-9"><SelectValue placeholder="Select type" /></SelectTrigger>
                        <SelectContent>
                          {(contentTypes ?? []).map((ct) => <SelectItem key={ct.id} value={ct.id}>{ct.name}</SelectItem>)}
                        </SelectContent>
                      </Select>
                    )} />
                    {errors.contentTypeId && <p className="text-xs text-destructive">{errors.contentTypeId.message}</p>}
                  </div>
                  <div className="grid grid-cols-2 gap-2">
                    <div className="space-y-1.5">
                      <Label className="text-xs">Schedule Date</Label>
                      <Input type="date" className="h-9" />
                    </div>
                    <div className="space-y-1.5">
                      <Label className="text-xs">Schedule Time</Label>
                      <Input type="time" className="h-9" />
                    </div>
                  </div>
                </div>
              </CollapsibleContent>
            </Collapsible>

            <Separator className="my-1" />

            {/* 3. Title & Slug */}
            <Collapsible>
              <CollapsibleTrigger className="flex items-center justify-between w-full py-2.5 px-1 hover:bg-muted/50 rounded-md transition-colors group">
                <span className="text-sm font-semibold">Title & Slug</span>
                <ChevronDown className="h-4 w-4 text-muted-foreground transition-transform group-data-[state=open]:rotate-180" />
              </CollapsibleTrigger>
              <CollapsibleContent>
                <div className="pb-4 pt-1 px-1 space-y-3">
                  <div className="space-y-1.5">
                    <Label className="text-xs">Title</Label>
                    <Input value={watchedTitle} readOnly className="h-9 bg-muted/50 text-sm" />
                    <p className="text-xs text-muted-foreground">{(watchedTitle || '').length}/200</p>
                  </div>
                  <div className="space-y-1.5">
                    <Label className="text-xs">Slug</Label>
                    <Input value={slugValue} onChange={(e) => setSlugValue(e.target.value)} className="h-9 font-mono text-sm" />
                  </div>
                </div>
              </CollapsibleContent>
            </Collapsible>

            <Separator className="my-1" />

            {/* 4. Categories */}
            <Collapsible>
              <CollapsibleTrigger className="flex items-center justify-between w-full py-2.5 px-1 hover:bg-muted/50 rounded-md transition-colors group">
                <span className="text-sm font-semibold">Categories</span>
                <ChevronDown className="h-4 w-4 text-muted-foreground transition-transform group-data-[state=open]:rotate-180" />
              </CollapsibleTrigger>
              <CollapsibleContent>
                <div className="pb-4 pt-1 px-1 space-y-3">
                  <Controller control={control} name="categoryId" render={({ field }) => (
                    <Select value={field.value ?? ''} onValueChange={field.onChange}>
                      <SelectTrigger className="h-9"><SelectValue placeholder="Select category" /></SelectTrigger>
                      <SelectContent>
                        {(categories ?? []).map((cat) => <SelectItem key={cat.id} value={cat.id}>{cat.name}</SelectItem>)}
                      </SelectContent>
                    </Select>
                  )} />
                </div>
              </CollapsibleContent>
            </Collapsible>

            <Separator className="my-1" />

            {/* 5. Tags */}
            <Collapsible>
              <CollapsibleTrigger className="flex items-center justify-between w-full py-2.5 px-1 hover:bg-muted/50 rounded-md transition-colors group">
                <span className="text-sm font-semibold">Tags</span>
                <ChevronDown className="h-4 w-4 text-muted-foreground transition-transform group-data-[state=open]:rotate-180" />
              </CollapsibleTrigger>
              <CollapsibleContent>
                <div className="pb-4 pt-1 px-1 space-y-3">
                  <div className="flex flex-wrap gap-1.5">
                    {selectedTagIds.map((tagId) => {
                      const tag = allTags?.find((t) => t.id === tagId);
                      return (
                        <Badge key={tagId} variant="secondary" className="gap-1 text-xs">
                          {tag?.name ?? tagId}
                          <button type="button" onClick={() => removeTag(tagId)} className="hover:text-destructive"><X className="h-3 w-3" /></button>
                        </Badge>
                      );
                    })}
                  </div>
                  <div className="relative">
                    <Search className="absolute left-2.5 top-1/2 -translate-y-1/2 h-3.5 w-3.5 text-muted-foreground" />
                    <Input value={tagSearch} onChange={(e) => setTagSearch(e.target.value)} placeholder="Search tags..." className="pl-8 h-8 text-sm" />
                  </div>
                  {tagSearch && filteredTags.length > 0 && (
                    <div className="max-h-32 overflow-y-auto rounded-md border bg-popover p-1 space-y-0.5">
                      {filteredTags.map((tag) => (
                        <button key={tag.id} type="button" onClick={() => addTag(tag.id)} className="w-full text-left px-2 py-1.5 text-sm rounded hover:bg-accent transition-colors">
                          {tag.name}
                        </button>
                      ))}
                    </div>
                  )}
                </div>
              </CollapsibleContent>
            </Collapsible>

            <Separator className="my-1" />

            {/* 6. SEO */}
            <Collapsible>
              <CollapsibleTrigger className="flex items-center justify-between w-full py-2.5 px-1 hover:bg-muted/50 rounded-md transition-colors group">
                <span className="text-sm font-semibold">SEO</span>
                <ChevronDown className="h-4 w-4 text-muted-foreground transition-transform group-data-[state=open]:rotate-180" />
              </CollapsibleTrigger>
              <CollapsibleContent>
                <div className="pb-4 pt-1 px-1 space-y-3">
                  {/* SEO Score */}
                  <div className="flex items-center justify-between">
                    <span className="text-xs font-medium">SEO Score</span>
                    <span className={cn('text-sm font-bold tabular-nums', seoScoreColor)}>{seoScore}/100</span>
                  </div>
                  <Progress value={seoScore} className={cn('h-2', seoProgressColor)} />

                  <div className="space-y-1.5">
                    <div className="flex justify-between"><Label className="text-xs">Meta Title</Label><span className="text-[10px] text-muted-foreground">{(watchedSeoTitle || '').length}/60</span></div>
                    <Input {...register('seoTitle')} placeholder="Meta title for search engines" className="h-9 text-sm" />
                  </div>
                  <div className="space-y-1.5">
                    <div className="flex justify-between"><Label className="text-xs">Meta Description</Label><span className="text-[10px] text-muted-foreground">{(watchedSeoDescription || '').length}/160</span></div>
                    <Textarea {...register('seoDescription')} placeholder="Meta description for search engines" rows={2} className="text-sm" />
                  </div>

                  {/* Google Preview */}
                  <div className="rounded-lg border p-3 bg-background">
                    <p className="text-[10px] text-muted-foreground mb-2">Google Preview</p>
                    <p className="text-blue-700 dark:text-blue-400 text-sm font-medium line-clamp-1 hover:underline cursor-pointer">
                      {watchedSeoTitle || watchedTitle || 'Your Page Title' }
                    </p>
                    <p className="text-green-700 dark:text-green-500 text-xs mt-0.5">yoursite.com/blog/{slugValue || 'your-slug'}</p>
                    <p className="text-xs text-muted-foreground mt-1 line-clamp-2">
                      {watchedSeoDescription || watchedExcerpt || 'A description of your page will appear here...'}
                    </p>
                  </div>
                </div>
              </CollapsibleContent>
            </Collapsible>
          </div>
        </aside>
      </div>

      {/* BOTTOM: AI Assistant Bar */}
      <div className="border-t bg-muted/30 px-6 py-3 shrink-0">
        <div className="flex items-center gap-3 max-w-3xl mx-auto">
          <Sparkles className="h-5 w-5 text-amber-500 shrink-0" />
          <div className="relative flex-1">
            <Input
              value={aiInput}
              onChange={(e) => setAiInput(e.target.value)}
              placeholder="Ask AI to edit your content..."
              className="rounded-full h-9 pr-10 bg-background"
            />
            <button className="absolute right-2 top-1/2 -translate-y-1/2 h-7 w-7 rounded-full bg-primary flex items-center justify-center">
              <Send className="h-3.5 w-3.5 text-primary-foreground" />
            </button>
          </div>
        </div>
        <div className="flex items-center gap-2 max-w-3xl mx-auto mt-2 overflow-x-auto pb-1">
          {AI_QUICK_ACTIONS.map((action) => (
            <button
              key={action}
              className="shrink-0 rounded-full border px-3 py-1 text-xs text-muted-foreground hover:bg-accent hover:text-foreground transition-colors"
            >
              {action}
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}
