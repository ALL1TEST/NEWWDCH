DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============================================================
# STRIPE (optional — leave blank to disable real billing)
# ============================================================
# When STRIPE_SECRET_KEY is set, the platform uses real Stripe Checkout
# for paid subscriptions; webhook events update the Subscription table.
#
# When blank, the platform still runs end-to-end for FREE plans (free
# trial / unlimited). Paid plan checkout returns 503 with a clear
# "Stripe not configured" error — it NEVER fakes a successful payment.
#
# Local development with Stripe CLI:
#   1. stripe login
#   2. stripe listen --forward-to localhost:3000/api/webhooks/stripe
#   3. Copy the `whsec_...` value here as STRIPE_WEBHOOK_SECRET
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_APP_URL=http://localhost:3000
