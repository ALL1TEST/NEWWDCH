// ============================================================
// PLATFORM BILLING CONFIG — editable single source of truth for
// plans, pricing, entitlements, usage limits, coupons, country
// pricing, and per-customer feature overrides. Managed from the
// Platform Admin. Reused by the Client Billing experience so an
// owner edit propagates to clients immediately.
// ============================================================

// The editable plan definition. The Client Billing API reads price,
// features, entitlements and limits from here — NOT from a hardcoded
// constant. `features` is marketing copy; `entitlements` is the
// authoritative feature-key list checked by hasFeature().
//
// planId values: 'free' | 'plus' | 'pro' | 'max' | custom.
// freePlanDurationDays: null = unlimited; positive N = trial duration in
//   days for free plans (enforced server-side; expired trial blocks
//   gated features).
// stripePriceIdMonthly/Yearly: optional Stripe Price IDs for real
//   recurring billing. Empty = Stripe not yet wired for this plan; the
//   checkout API refuses to fake success in that case.
model PlanConfig {
  id                   String   @id @default(cuid())
  planId               String   @unique // 'free' | 'plus' | 'pro' | 'max' | custom
  name                 String
  priceMonthly         Int      @default(0) // major currency units (49 = 49 CHF)
  priceYearly          Int      @default(0)
  currency             String   @default("CHF")
  interval             String   @default("monthly") // monthly | yearly — default cadence; client can pick
  isFree               Boolean  @default(false)
  freePlanDurationDays Int? // null = unlimited; positive N = trial duration in days for free plans
  stripePriceIdMonthly String? // Stripe Price ID for monthly billing; null = not yet wired
  stripePriceIdYearly  String? // Stripe Price ID for yearly billing; null = not yet wired
  active               Boolean  @default(true)
  features             String   @default("[]") // JSON: string[] (marketing)
  entitlements         String   @default("[]") // JSON: string[] (feature keys)
  limits               String   @default("{}") // JSON: { maxSites, storageBytes, aiWords, aiArticles, automationRuns }
  badgeVariant         String   @default("") // maps to client badge styling
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active])
  @@index([sortOrder])
}

// Real customer subscription state. The source of truth for the Client
// Billing dashboard, entitlements, usage limits, and renewal dates. One
// row per user (enforced by @@unique([userId])). Updated by Stripe
// webhooks when Stripe is configured; otherwise created by the free-plan
// flow and the admin-assigned-plan flow.
//
// `status` is one of: 'active' | 'trial' | 'past_due' | 'cancelled' |
// 'expired'. Calendar-based periods: monthly = addMonths(1), yearly =
// addYears(1) — never +30 days.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique // one active subscription per user
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId               String // references PlanConfig.planId (loose ref; lookup via plan-config cache)
  plan                 PlanConfig? @relation(fields: [planId], references: [planId], onDelete: Restrict)
  billingInterval     String    @default("monthly") // monthly | yearly — chosen cadence for THIS subscription
  status               String    @default("active") // active | trial | past_due | cancelled | expired
  startDate            DateTime  @default(now()) // when this subscription started
  currentPeriodEnd     DateTime? // next billing/expiration date; null = no renewal (cancelled)
  trialEnd             DateTime? // for free trial / paid trial; null = not a trial
  cancelAt             DateTime? // scheduled cancellation; null = no scheduled cancellation
  freePlanDurationDays Int? // copied from PlanConfig at subscription time; null = unlimited free
  stripeCustomerId     String? // Stripe Customer ID
  stripeSubscriptionId String? // Stripe Subscription ID
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  payments Payment[]

  @@index([planId])
  @@index([status])
  @@index([currentPeriodEnd])
}

// Real payment / invoice record. Stripe is the source of truth when
// configured; in dev (no Stripe keys) only free / no-charge payments are
// recorded. Never fake a 'paid' status — checkout returns 503 if Stripe
// is not configured and the plan has a positive price.
//
// Every payment row is fully relational: it connects to its Customer
// (userId → User), Subscription (subscriptionId), Plan (planId →
// PlanConfig), Stripe Invoice (stripeInvoiceId), Stripe PaymentIntent
// (stripePaymentIntentId), Stripe Charge (stripeChargeId), and the
// payment method metadata (paymentMethodType + paymentMethodDetails
// JSON: brand, last4, expMonth, expYear, funding, country). All of these
// are populated by the Stripe webhook (invoice.paid / checkout.session
// completed / payment_intent.*) so the admin Payments table, the
// customer detail view, and the Dashboard always reflect the real Stripe
// state. Stripe is the source of truth; this table mirrors it.
model Payment {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId          String
  amount          Int          @default(0) // major currency units (e.g. 49 = 49 CHF)
  currency        String       @default("CHF") // ISO 4217 (USD, EUR, CHF, ...)
  status          String       @default("pending") // pending | paid | failed | refunded
  method          String? // display label, e.g. "Visa ••4242" or "Stripe"
  invoiceNumber   String? // human-readable invoice reference, e.g. "INV-2026-1042"
  // ---- Stripe relational refs (source of truth when Stripe is configured) ----
  stripeInvoiceId        String? // Stripe Invoice ID (in_...)
  stripePaymentIntentId  String? // Stripe PaymentIntent ID (pi_...)
  stripeChargeId         String? // Stripe Charge ID (ch_...) — populated from the PI's latest charge
  // ---- Payment method metadata (mirrors Stripe PaymentMethod) ----
  paymentMethodType      String? // 'card' | 'ach_debit' | 'sepa_debit' | 'link' | ...
  paymentMethodDetails   String? // JSON: { brand, last4, expMonth, expYear, funding, country, wallet }
  description            String? // optional memo / failure reason / line description
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([planId])
  @@index([stripeInvoiceId])        // webhook dedup: find by invoice
  @@index([stripePaymentIntentId])  // webhook dedup: find by payment intent
}

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique
  type             String    @default("percent") // percent | fixed
  value            Int       @default(0) // percent: 0-100; fixed: amount in major units
  currency         String    @default("CHF")
  applicablePlans  String    @default("[]") // JSON planId[]; empty = all plans
  startsAt         DateTime?
  expiresAt        DateTime?
  maxRedemptions   Int? // null = unlimited
  perCustomerLimit Int?
  active           Boolean   @default(true)
  timesRedeemed    Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([active])
  @@index([code])
}

model CountryPricing {
  id             String   @id @default(cuid())
  countryCode    String   @unique // ISO 3166-1 alpha-2: US, CH, MA, ...
  countryName    String
  currency       String // USD, EUR, CHF, MAD
  isDefault      Boolean  @default(false)
  regionalPrices String   @default("{}") // JSON map planId → { monthly, yearly }
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
  @@index([isDefault])
}

// Per-customer feature grant/revoke that does NOT change the plan.
// e.g. "Beta customer + Automation enabled until 2025-12-31".
model CustomerEntitlementOverride {
  id            String    @id @default(cuid())
  customerEmail String
  feature       String // entitlement key, e.g. 'automation'
  granted       Boolean  @default(true)
  grantedUntil  DateTime? // null = no expiry
  reason        String?
  createdBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([customerEmail, feature])
  @@index([customerEmail])
}

