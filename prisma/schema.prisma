// ============================================================
// MULTI-SITE CORE
// ============================================================

model Site {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  domain      String?
  description String?
  logo        String?
  favicon     String?
  status      SiteStatus  @default(ACTIVE)
  config      String?     // JSON: theme, seo defaults, social links, etc.
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Content
  contentTypes        ContentType[]
  contentItems        ContentItem[]
  contentVersions     ContentVersion[]
  contentTemplates    ContentTemplate[]
  reusableBlocks      ReusableBlock[]
  homepageLayouts     HomepageLayout[]
  fieldPermissions    FieldPermission[]

  // Media
  media               Media[]
  mediaFolders        MediaFolder[]
  mediaCollections    MediaCollection[]
  mediaCollectionItems MediaCollectionItem[]
  mediaUsages         MediaUsage[]

  // Navigation & SEO
  navigations         Navigation[]
  navigationVersions  NavigationVersion[]
  redirects           Redirect[]
  seoConfigs          SeoConfig[]
  seoSettings         SeoSetting[]
  sitemapConfigs      SitemapConfig[]
  robotsTxts          RobotsTxt[]
  searchConsoleConns  SearchConsoleConnection[]
  seoIssues           SeoIssue[]
  brokenLinks         BrokenLink[]
  indexingRecords     IndexingRecord[]
  searchConsoleStats  SearchConsoleStat[]
  searchConsoleQueries SearchConsoleQuery[]
  searchConsolePages  SearchConsolePage[]

  // Taxonomy
  categories          Category[]
  tags                Tag[]

  // Engagement
  comments            Comment[]
  forms               Form[]
  formSubmissions     FormSubmission[]
  newsletterSubscribers NewsletterSubscriber[]
  newsletterCampaigns NewsletterCampaign[]

  // Analytics
  analyticsEvents     AnalyticsEvent[]

  // Platform
  settings            Setting[]
  webhooks            Webhook[]
  webhookDeliveries   WebhookDelivery[]
  notifications       Notification[]
  bulkOperations      BulkOperation[]
  savedFilters        SavedFilter[]
  importExportJobs    ImportExportJob[]

  // AI
  aiProviders         AiProvider[]
  aiJobs              AiJob[]
  aiLogs              AiLog[]
  promptTemplates     PromptTemplate[]

  // Infrastructure
  queueJobs           QueueJob[]

  // API
  apiKeys             ApiKey[]
  oAuthClients        OAuthClient[]

  // Backups
  backups             Backup[]
  backupSchedules     BackupSchedule[]
  backupLogs          BackupLog[]
  backupStorages      BackupStorage[]

  // Email
  emailTemplates      EmailTemplate[]
  smtpSettings        SmtpSetting[]

  // Monitoring
  systemMetrics       SystemMetric[]
  errorLogs           ErrorLog[]
  alertRules          AlertRule[]
  alerts              Alert[]
  securityEvents      SecurityEvent[]
  schedulerLogs       SchedulerLog[]

  @@index([slug])
  @@index([status])
}

// ============================================================
// USER & IDENTITY (5 entities)
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  avatar        String?
  bio           String?
  website       String?
  role          UserRole  @default(EDITOR)
  status        UserStatus @default(ACTIVE)
  // Billing bypass flag. INTERNAL/EXEMPT users skip plan gating, get full
  // feature access, and are excluded from customer/MRR counts. Not keyed
  // by email — a proper account-level entitlement.
  billingMode   BillingMode @default(EXTERNAL)
  password      String?
  emailVerified Boolean   @default(false)
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  recoveryCodes String?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt       DateTime?
  assignedSites   String?
  sitePermissions String?
  pagePermissions String?  // JSON array of page keys, e.g. ["articles","media","calendar"]

  // Relations
  authoredContent   ContentItem[]
  authorProfile     AuthorProfile?
  sessions          Session[]
  accounts          Account[]
  apiKeys              ApiKey[]
  oAuthClients         OAuthClient[]
  personalAccessTokens PersonalAccessToken[]
  reviewAssignments    ReviewAssignment[] @relation("Reviewer")
  comments          Comment[]
  notifications     UserNotificationPreference?
  auditLogs         AuditLog[]
  bulkOperations    BulkOperation[]
  savedFilters      SavedFilter[]
  aiProviders       AiProvider[] @relation("AiProviderCreator")
  aiJobs            AiJob[] @relation("AiJobCreator")
  aiLogs            AiLog[]
  promptTemplates   PromptTemplate[] @relation("PromptCreator")
  contentContributions ContentContributor[]
  promptTemplateVersions PromptTemplateVersion[] @relation("PromptVersionAuthor")
  webhooks          Webhook[] @relation("WebhookCreator")
  newsletterCampaigns NewsletterCampaign[] @relation("CampaignAuthor")
  backups           Backup[] @relation("BackupCreator")
  backupSchedules   BackupSchedule[] @relation("BackupScheduleCreator")
  backupStorages    BackupStorage[] @relation("BackupStorageCreator")
  backupLogs        BackupLog[] @relation("BackupLogCreator")
  mediaUploads      Media[] @relation("MediaUploader")
  navVersionCreations NavigationVersion[] @relation("NavVersionAuthor")
  dashboardLayouts  UserDashboardLayout[]
  reviewComments    ReviewComment[]
  translationReviews PostTranslation[] @relation("TranslationReviewer")
  translations     PostTranslation[] @relation("Translator")
  contentVersions   ContentVersion[]
  emailTemplates    EmailTemplate[] @relation("EmailTemplateCreator")

  // Monitoring
  errorLogs         ErrorLog[]
  resolvedErrorLogs ErrorLog[] @relation("ErrorLogResolver")
  acknowledgedAlerts Alert[] @relation("AlertAcknowledger")
  resolvedAlerts    Alert[] @relation("AlertResolver")
  securityEvents    SecurityEvent[]

  // Billing (real subscription + payment records — DB-backed source of truth)
  subscription      Subscription?
  payments          Payment[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model AuthorProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String?
  slug        String   @unique
  bio         String?
  website     String?
  twitter     String?
  github      String?
  linkedin    String?
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content ContentItem[] @relation("AuthorProfile")

  @@index([slug])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  deviceHash   String?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model Account {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  providerId   String
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model ApiKey {
  id               String              @id @default(cuid())
  name             String
  description      String?
  keyHash          String
  keyPrefix        String
  type             ApiKeyType          @default(LIVE)
  status           ApiKeyStatus        @default(ACTIVE)
  environment      ApiKeyEnvironment   @default(PRODUCTION)
  scopes           String
  userId           String
  siteId           String?
  siteAccess       ApiKeySiteAccess    @default(CURRENT)
  allowedSiteIds   String?             // JSON array of site IDs when siteAccess is SELECTED
  allowedIps       String?             // JSON array of IP/CIDR patterns
  allowedDomains   String?             // JSON array of allowed domains
  allowedOrigins   String?             // JSON array of CORS origins
  rateLimitPerMin  Int                 @default(100)
  rateLimitPerHour Int                 @default(1000)
  rateLimitPerDay  Int                 @default(10000)
  lastUsedAt       DateTime?
  lastUsedIp       String?
  totalRequests    Int                 @default(0)
  totalErrors      Int                 @default(0)
  expiresAt        DateTime?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  site    Site?    @relation(fields: [siteId], references: [id])
  apiLogs ApiLog[]

  @@index([keyHash])
  @@index([keyPrefix])
  @@index([userId])
  @@index([siteId])
  @@index([status])
  @@index([environment])
}

// ============================================================
// CONTENT MANAGEMENT (14 entities)
// ============================================================

model ContentType {
  id               String   @id @default(cuid())
  name             String
  slug             String
  description      String?
  icon             String?
  allowedStatuses  String
  fields           String
  isBuiltIn        Boolean  @default(false)
  siteId           String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  site           Site?           @relation(fields: [siteId], references: [id])
  contentItems   ContentItem[]
  fieldPermissions FieldPermission[]

  @@unique([slug, siteId])
  @@index([slug])
  @@index([siteId])
}

model ContentItem {
  id             String     @id @default(cuid())
  title          String
  slug           String
  status         PostStatus @default(DRAFT)
  version        Int        @default(0)
  content        String?
  excerpt        String?
  authorId       String
  contentTypeId  String
  featuredImageId String?
  categoryId     String?
  publishedAt    DateTime?
  scheduledAt    DateTime?
  expiresAt      DateTime?
  seoTitle       String?
  seoDescription String?
  seoImageId     String?
  focusKeyword   String?
  viewCount      Int        @default(0)
  siteId         String?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  site           Site?           @relation(fields: [siteId], references: [id])
  author         User             @relation(fields: [authorId], references: [id])
  contentType    ContentType       @relation(fields: [contentTypeId], references: [id])
  featuredImage  Media?            @relation("FeaturedImage", fields: [featuredImageId], references: [id])
  category       Category?         @relation(fields: [categoryId], references: [id])
  seoImage       Media?            @relation("SeoImage", fields: [seoImageId], references: [id])
  authorProfile  AuthorProfile?   @relation("AuthorProfile", fields: [authorId], references: [userId])
  tags           Tag[]
  versions       ContentVersion[]
  translations   PostTranslation[]
  reviewAssignments ReviewAssignment[]
  comments       Comment[]
  contributors   ContentContributor[]

  @@unique([slug, contentTypeId, deletedAt])
  @@index([authorId])
  @@index([contentTypeId])
  @@index([status])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([scheduledAt])
  @@index([siteId])
  @@index([createdAt])
  @@index([updatedAt])
}

model ContentVersion {
  id          String   @id @default(cuid())
  contentItemId String
  versionNumber Int
  title       String
  content     String?
  excerpt     String?
  changeNote  String?
  createdById String
  siteId      String?
  createdAt   DateTime @default(now())

  site        Site?       @relation(fields: [siteId], references: [id])
  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdBy   User       @relation(fields: [createdById], references: [id])

  @@unique([contentItemId, versionNumber])
  @@index([contentItemId])
  @@index([siteId])
}

model PostTranslation {
  id             String @id @default(cuid())
  contentItemId  String
  locale         String
  title          String
  content        String?
  excerpt        String?
  seoTitle       String?
  seoDescription String?
  status         TranslationAssignmentStatus @default(PENDING)
  translatedById String?
  reviewedById   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contentItem  ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  translatedBy User?      @relation("Translator", fields: [translatedById], references: [id])
  reviewedBy   User?      @relation("TranslationReviewer", fields: [reviewedById], references: [id])

  @@unique([contentItemId, locale])
  @@index([contentItemId])
  @@index([locale])
}

model ReviewAssignment {
  id             String       @id @default(cuid())
  contentItemId  String
  reviewerId     String
  status         ReviewStatus @default(PENDING)
  reviewNote     String?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  reviewer    User       @relation("Reviewer", fields: [reviewerId], references: [id])
  comments    ReviewComment[]

  @@index([contentItemId])
  @@index([reviewerId])
  @@index([status])
}

model ReviewComment {
  id               String       @id @default(cuid())
  reviewAssignmentId String
  authorId         String
  content          String
  status           ReviewStatus @default(PENDING)
  createdAt        DateTime     @default(now())

  reviewAssignment ReviewAssignment @relation(fields: [reviewAssignmentId], references: [id], onDelete: Cascade)
  author           User          @relation(fields: [authorId], references: [id])

  @@index([reviewAssignmentId])
}

model ContentContributor {
  id             String                 @id @default(cuid())
  contentItemId  String
  userId         String
  role           ContentContributorRole @default(AUTHOR)
  createdAt      DateTime               @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, userId])
  @@index([contentItemId])
  @@index([userId])
}

model ContentTemplate {
  id          String @id @default(cuid())
  name        String
  description String?
  content     String?
  thumbnailId String?
  siteId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  site     Site?  @relation(fields: [siteId], references: [id])
  thumbnail Media? @relation("TemplateThumbnail", fields: [thumbnailId], references: [id])

  @@index([name])
  @@index([siteId])
}

model ReusableBlock {
  id          String            @id @default(cuid())
  name        String
  type        ReusableBlockType @default(RICH_TEXT)
  content     String?
  category    String?
  siteId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  site Site? @relation(fields: [siteId], references: [id])

  @@index([name])
  @@index([type])
  @@index([siteId])
}

model HomepageLayout {
  id        String   @id @default(cuid())
  name      String
  layout    String
  isActive  Boolean  @default(false)
  publishedAt DateTime?
  siteId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  site Site? @relation(fields: [siteId], references: [id])

  @@index([isActive])
  @@index([siteId])
}

model FieldPermission {
  id            String  @id @default(cuid())
  contentTypeId String
  fieldName     String
  roleId        UserRole
  canRead       Boolean @default(true)
  canWrite      Boolean @default(false)
  siteId        String?

  site        Site?       @relation(fields: [siteId], references: [id])
  contentType ContentType @relation(fields: [contentTypeId], references: [id], onDelete: Cascade)

  @@unique([contentTypeId, fieldName, roleId])
  @@index([contentTypeId])
  @@index([roleId])
  @@index([siteId])
}

// ============================================================
// MEDIA MANAGEMENT (5 entities)
// ============================================================

model Media {
  id               String               @id @default(cuid())
  filename         String
  originalName     String
  mimeType         String
  size             Int
  width            Int?
  height           Int?
  alt              String?
  caption          String?
  seoTitle         String?
  metaDescription  String?
  focusKeywords    String?
  imageDescription String?
  folderId         String?
  url              String
  thumbnailUrl     String?
  processingStatus MediaProcessingStatus @default(UPLOADING)
  scanStatus       MediaScanStatus       @default(PENDING)
  metadata         String?
  blurhash         String?
  uploadedById     String
  siteId           String?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  site               Site?                   @relation(fields: [siteId], references: [id])
  folder             MediaFolder?            @relation(fields: [folderId], references: [id])
  uploadedBy         User                    @relation("MediaUploader", fields: [uploadedById], references: [id])
  featuredContent     ContentItem[]           @relation("FeaturedImage")
  seoContent          ContentItem[]           @relation("SeoImage")
  templateThumbnails  ContentTemplate[]       @relation("TemplateThumbnail")
  seoOgImages         SeoConfig[]            @relation("SeoOgImage")
  collections         MediaCollectionItem[]
  usages              MediaUsage[]

  @@index([folderId])
  @@index([mimeType])
  @@index([uploadedById])
  @@index([processingStatus])
  @@index([siteId])
  @@index([createdAt])
}

model MediaFolder {
  id        String  @id @default(cuid())
  name      String
  parentId  String?
  siteId    String?
