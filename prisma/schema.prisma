generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum PostStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
}

enum UserRole {
  ADMIN
  EDITOR
  PLATFORM_ADMIN
  OWNER
  CLIENT
}

// Billing mode controls whether a user is a paying customer or has a
// platform-level billing bypass. INTERNAL = owner/staff (full access,
// not counted in MRR). EXEMPT = complimentary (full access, tracked,
// not counted in MRR). EXTERNAL = normal paying customer.
enum BillingMode {
  EXTERNAL
  INTERNAL
  EXEMPT
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ContentContributorRole {
  AUTHOR
  CO_AUTHOR
  REVIEWER
  TRANSLATOR
}

enum TranslationAssignmentStatus {
  PENDING
  IN_PROGRESS
  REVIEW
  APPROVED
}

enum MediaScanStatus {
