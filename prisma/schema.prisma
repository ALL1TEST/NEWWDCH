  createdAt   DateTime         @default(now())

  site Site? @relation(fields: [siteId], references: [id])

  @@index([metricType])
  @@index([siteId])
  @@index([createdAt])
}

model ErrorLog {
  id            String           @id @default(cuid())
  exception     String
  message       String?          @default("")
  stackTrace    String?
  module        String?          @default("")
  url           String?
  httpMethod    String?
  userId        String?
  ipAddress     String?
  userAgent     String?
  severity      ErrorLogSeverity @default(ERROR)
  environment   String?          @default("production")
  isResolved    Boolean          @default(false)
  resolvedById  String?
  resolvedAt    DateTime?
  siteId        String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  site        Site?  @relation(fields: [siteId], references: [id])
  user        User?  @relation(fields: [userId], references: [id])
  resolvedBy  User?  @relation("ErrorLogResolver", fields: [resolvedById], references: [id])

  @@index([severity])
  @@index([module])
  @@index([isResolved])
  @@index([siteId])
  @@index([createdAt])
}

model AlertRule {
  id            String          @id @default(cuid())
  name          String
  description   String?         @default("")
  metricType    String          // cpu, ram, disk, backup_failed, smtp_offline, etc.
  condition     String          // gt, gte, lt, lte, eq, neq
  threshold     Float
  durationSec   Int             @default(60)
  severity      MonitorSeverity @default(HIGH)
  channels      String          @default("[\"IN_APP\"]")  // JSON array of AlertChannel
  isActive      Boolean         @default(true)
  cooldownSec   Int             @default(300)
  lastTriggered DateTime?
  siteId        String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  site Site? @relation(fields: [siteId], references: [id])
  alerts Alert[]

  @@index([isActive])
  @@index([metricType])
  @@index([siteId])
}

model Alert {
  id          String       @id @default(cuid())
  ruleId      String
  title       String
  message     String
  severity    MonitorSeverity @default(HIGH)
  status      AlertStatus  @default(TRIGGERED)
  metricValue Float?
  threshold   Float?
  channels    String       @default("[\"IN_APP\"]")
  acknowledgedById String?
  acknowledgedAt DateTime?
  resolvedById    String?
  resolvedAt      DateTime?
  siteId      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  rule         AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  acknowledgedBy User?   @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id])
  resolvedBy     User?   @relation("AlertResolver", fields: [resolvedById], references: [id])
  site           Site?   @relation(fields: [siteId], references: [id])

  @@index([ruleId])
  @@index([status])
  @@index([severity])
  @@index([siteId])
  @@index([createdAt])
}

model SecurityEvent {
  id            String           @id @default(cuid())
  eventType     SecurityEventType @default(UNKNOWN)
  description   String           @default("")
  ipAddress     String?
  userAgent     String?
  userId        String?
  details       String?          // JSON
  siteId        String?
  createdAt     DateTime         @default(now())

  site Site? @relation(fields: [siteId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  @@index([eventType])
  @@index([ipAddress])
  @@index([userId])
  @@index([siteId])
  @@index([createdAt])
}

model SchedulerLog {
  id            String            @id @default(cuid())
  jobName       String
  jobType       String            @default("")
  status        SchedulerJobStatus @default(ENABLED)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  lastDuration  Int?              // ms
  lastError     String?
  runCount      Int               @default(0)
  failCount     Int               @default(0)
  cronExpr      String?           @default("")
  siteId        String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  site Site? @relation(fields: [siteId], references: [id])

  @@index([jobName])
  @@index([status])
  @@index([siteId])
  @@index([nextRunAt])
}

model MonitorSetting {
  id        String  @id @default(cuid())
  key       String  @unique
  value     String  @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// AUTOMATION MODELS
// ============================================================

model Automation {
  id              String   @id @default(cuid())
  siteId          String?
  name            String
  description     String   @default("")
  triggerType     String   @default("MANUAL") // MANUAL | SCHEDULED
  scheduleConfig  String   @default("{}") // JSON: frequency, time, timezone, startDate, endDate
  workflowConfig  String   @default("{}") // JSON: contentGeneration, seoProcessing, media, finalAction
  status          String   @default("ACTIVE") // ACTIVE | PAUSED | FAILED
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  totalRuns       Int      @default(0)
  successfulRuns  Int      @default(0)
  failedRuns      Int      @default(0)
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  runs      AutomationRun[]

  @@index([status])
  @@index([siteId])
  @@index([nextRunAt])
  @@index([createdById])
}

model AutomationRun {
  id              String   @id @default(cuid())
  automationId    String
  status          String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED | CANCELLED
  startedAt       DateTime?
  finishedAt      DateTime?
  durationMs      Int?
  generatedArticleId String?
  generatedArticleName String?
  errorMessage    String?
  failedStep      String?
  logsJson        String   @default("[]") // JSON array of {timestamp, step, message, level}
  createdAt       DateTime @default(now())

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
  @@index([status])
  @@index([createdAt])
}
